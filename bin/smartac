#!/usr/bin/env bash
# SmartThings AC backend. Owns every HTTP call and the keyring token; prints
# JSON on stdout and nothing else, so the QML never parses prose.
set -uo pipefail

API="https://api.smartthings.com/v1"

# Ceilings on anything the far end controls. A real status payload is a few
# kilobytes and a real account has a handful of air conditioners, so these are
# generous by orders of magnitude -- their job is to make the cost of a hostile
# or broken response bounded, not to be tight. Nothing derived from the network
# reaches QML without passing one of them.
MAX_RESPONSE_BYTES=1048576   # a whole HTTP response, enforced while it arrives
MAX_STRING=128               # any single string forwarded to the panel
MAX_LIST=64                  # entries in a supported-values list
MAX_DEVICES=200              # rows in the device picker

die()  { printf '{"error":%s}\n' "$(jq -Rn --arg m "$1" '$m')" >&2; exit "${2:-1}"; }

# Prelude shared by every jq filter that shapes a remote payload into the small
# object QML consumes. A device label, a mode name and a supported-values list
# are all attacker-controlled in the threat model where the cloud endpoint is
# not trusted, and none of them has a legitimate reason to be long.
JQ_CLAMP='
  # Angle brackets are removed, not escaped. QML Text defaults to AutoText,
  # which interprets markup -- including external resource references -- inside
  # the long-lived shell process shared by every widget. Several surfaces that
  # receive these strings are shell components this plugin cannot set
  # textFormat on, so the safest place to make the text inert is here, before
  # it leaves the only process that talks to the network.
  def clampstr($n): if type == "string" then (.[0:$n] | gsub("[<>]"; "")) else . end;
  def clampstr: clampstr($MAXSTR);
  def clamplist: if type == "array" then [ .[0:$MAXLIST][] | clampstr ] else [] end;
'
jq_shape() { jq --argjson MAXSTR "$MAX_STRING" --argjson MAXLIST "$MAX_LIST" "$@"; }
need() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1" 4; }
need jq

# ------------------------------------------------------------- credential --
#
# One source: the session the SmartThings CLI holds. This plugin stores no
# credential of its own and never touches the keyring.
#
# The alternative, a personal access token, was removed rather than kept as a
# fallback. SmartThings expires one 24 hours after it is created, which makes a
# bar widget ask for a new credential every morning -- and a fallback nobody
# should choose is a second setup screen, a second failure mode and a second
# thing to explain, bought for a path that does not work.
#
# Registering an OAuth app is the other route, and it is closed to a whole
# class of user: authorising one means installing it into a location you own,
# so anyone whose home was set up by someone else and shared with them cannot
# complete it. The CLI's own client installs with no location and sidesteps it.

cli_credentials_file() {
  local f
  for f in "${XDG_DATA_HOME:-$HOME/.local/share}/@smartthings/cli/credentials.json" \
           "${XDG_CONFIG_HOME:-$HOME/.config}/@smartthings/cli/credentials.json"; do
    [[ -r $f ]] && { printf '%s' "$f"; return 0; }
  done
  return 1
}

# The CLI refreshes an hour before expiry, so any command it runs inside that
# window renews the session. Rather than rotate the pair here -- writing another
# tool's credential file, and owning the failure where a spent refresh token is
# never replaced -- we let it do its own job and simply ask.
# PATH is not a reliable way to find this. The shell that runs this plugin gets
# its environment from the session, not from the user's terminal rc, so a CLI
# installed through nvm, mise, volta, asdf or an npm prefix can be perfectly
# present and still invisible here -- and the failure is silent and delayed: the
# session works for a day and then stops renewing.
#
# So the binary is looked for where these tools actually put it, rather than the
# user being told to repair a PATH they did not know was involved.
cli_bin() {
  local c
  c=$(command -v smartthings 2>/dev/null) && { printf '%s' "$c"; return 0; }
  local prefix
  prefix=$(npm config get prefix 2>/dev/null) || prefix=""
  for c in ${prefix:+"$prefix/bin/smartthings"} \
           "$HOME/.local/share/mise/shims/smartthings" \
           "$HOME/.local/bin/smartthings" \
           "$HOME/.npm-global/bin/smartthings" \
           "$HOME/.volta/bin/smartthings" \
           "$HOME/.asdf/shims/smartthings" \
           "$HOME/.bun/bin/smartthings" \
           /usr/local/bin/smartthings /usr/bin/smartthings; do
    [[ -x $c ]] && { printf '%s' "$c"; return 0; }
  done
  # Version managers keep one copy per installed runtime; take the newest.
  for c in "$HOME"/.local/share/mise/installs/node/*/bin/smartthings \
           "$HOME"/.nvm/versions/node/*/bin/smartthings \
           "$HOME"/.local/share/fnm/node-versions/*/installation/bin/smartthings; do
    [[ -x $c ]] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

cli_refresh() {
  local bin
  bin=$(cli_bin) || return 1
  "$bin" locations --json >/dev/null 2>&1
}

TOKEN_VALUE=""
resolve_token() {
  local f entry exp exp_s now_s
  f=$(cli_credentials_file) || return 1
  entry=$(jq -c 'to_entries | map(select(.value.accessToken | type == "string")) | .[0] // empty' "$f" 2>/dev/null)
  [[ -n $entry ]] || return 1

  # Half an hour of margin: inside the CLI's own refresh window, so asking it
  # actually renews rather than handing back the same nearly-dead token.
  exp=$(jq -r '.value.expires // empty' <<<"$entry")
  if [[ -n $exp ]]; then
    exp_s=$(date -d "$exp" +%s 2>/dev/null) || exp_s=0
    now_s=$(date +%s)
    if (( exp_s > 0 && exp_s - now_s < 1800 )); then
      cli_refresh
      entry=$(jq -c 'to_entries | map(select(.value.accessToken | type == "string")) | .[0] // empty' "$f" 2>/dev/null)
      [[ -n $entry ]] || return 1
    fi
  fi

  TOKEN_VALUE=$(jq -r '.value.accessToken' <<<"$entry")
  [[ -n $TOKEN_VALUE && $TOKEN_VALUE != null ]] || return 1
}

# The panel needs to tell three states apart: ready, the CLI is missing, and the
# CLI is there but nobody has logged in. Each has a different next step.
cmd_credential() {
  local installed=false session=false renewable=false
  cli_bin >/dev/null 2>&1 && installed=true
  resolve_token 2>/dev/null && session=true
  [[ $installed == true && $session == true ]] && renewable=true
  printf '{"ready":%s,"cliInstalled":%s,"session":%s,"renewable":%s}\n' \
    "$session" "$installed" "$session" "$renewable"
}

api() {
  need curl
  local method="$1" path="$2" body="${3:-}" token raw status out token_escaped
  resolve_token || die "no SmartThings CLI session; run: smartthings locations" 2
  token="$TOKEN_VALUE"

  # Escape backslashes and double quotes in token for curl's config format.
  # SmartThings tokens are opaque strings unlikely to contain these characters,
  # but escaping them ensures the header is formed correctly if they do.
  token_escaped="${token//\\/\\\\}"
  token_escaped="${token_escaped//\"/\\\"}"

  local args=(-sS -X "$method" -H "Accept: application/json" -m 15
              --max-filesize "$MAX_RESPONSE_BYTES" -w $'\n%{http_code}')
  [[ -n $body ]] && args+=(-H "Content-Type: application/json" -d "$body")

  # The response is bounded while it is still arriving, not after it has been
  # read. head closes the pipe once it has taken its fill and curl dies of
  # SIGPIPE, so an oversized or never-terminating stream costs this much and
  # stops -- it cannot grow a shell variable without limit, and it cannot reach
  # the QML side's StdioCollector, which would put the whole shared shell at the
  # mercy of whatever answers on the other end of the socket.
  #
  # --max-filesize covers the honest case where a length is declared up front;
  # head covers the dishonest one where it is not. Both are needed.
  #
  # One extra byte is requested so that hitting the ceiling is distinguishable
  # from landing exactly on it, and overflow fails closed: a truncated body is
  # not parsed, guessed at, or passed on.
  #
  # curl's own stderr is silenced: a malformed -K record (see cmd_token's
  # control-character check) makes curl echo the offending config line back
  # on stderr, and this process's stderr is not collected by the QML side —
  # it would otherwise flow straight into the shell's journal.
  local curl_rc
  raw=$(
    printf 'header = "Authorization: Bearer %s"\n' "$token_escaped" \
      | curl -K - "${args[@]}" "$API$path" 2>/dev/null \
      | head -c "$((MAX_RESPONSE_BYTES + 1))"
    # Inside the substitution, where the pipeline that just ran is still the
    # one PIPESTATUS describes. Read from the right, so a body containing
    # newlines cannot be mistaken for it.
    printf '\n%s' "${PIPESTATUS[1]}"
  )
  curl_rc="${raw##*$'\n'}"
  raw="${raw%$'\n'*}"

  # Size is judged before curl's exit status, because enforcing the ceiling is
  # what kills curl: head closes the pipe, curl dies of SIGPIPE, and its status
  # is non-zero as a direct result. Reading the status first would report every
  # oversized response as a network failure and hide the thing being defended
  # against.
  (( $(printf '%s' "$raw" | wc -c) > MAX_RESPONSE_BYTES )) \
    && die "the response exceeded $MAX_RESPONSE_BYTES bytes and was refused" 10
  [[ $curl_rc == 0 ]] || die "network unreachable" 6

  status="${raw##*$'\n'}"
  out="${raw%$'\n'*}"

  case "$status" in
    2*)  printf '%s' "$out" ;;
    401) # One refresh, one retry, then stop rather than loop against a dead
         # authorisation. Nothing is deleted: the session belongs to the CLI.
         if [[ ${ST_RETRIED:-0} == 0 ]] && cli_refresh; then
           ST_RETRIED=1 api "$method" "$path" "$body"
           return $?
         fi
         die "the SmartThings CLI session was rejected; run: smartthings locations" 3 ;;
    429) die "rate limited by SmartThings" 7 ;;
    *)   die "SmartThings returned HTTP $status" 8 ;;
  esac
}

# ----------------------------------------------------------------- devices --

cmd_devices() {
  # airConditionerMode, not switch: switch alone matches every lamp in the
  # account, and a picker full of lamps is worse than no picker.
  api GET /devices | jq_shape --argjson MAXDEV "$MAX_DEVICES" "$JQ_CLAMP"'{
    devices: [ .items[]?
      | select(any(.components[]?.capabilities[]?; .id == "airConditionerMode"))
      | { id: (.deviceId | clampstr), label: ((.label // .name // .deviceId) | clampstr) } ][0:$MAXDEV]
  }'
}

# ------------------------------------------------------------------ status --

require_device() { [[ -n ${1:-} ]] || die "pass --device <id>" 2; }

cmd_status() {
  local device="" quick=0
  while (( $# )); do
    case "$1" in
      --device) [[ -n ${2:-} ]] || die "--device requires a value" 2; device="$2"; shift 2 ;;
      --json)   shift ;;
      # Skips the reachability call and reports online as null -- unknown, not
      # false. The panel uses this when confirming a write it just sent: it
      # already knows whether the device is reachable, and halving the requests
      # is what lets the confirmation run at three seconds instead of eight.
      --quick)  quick=1; shift ;;
      *)        die "unknown argument: $1" 2 ;;
    esac
  done
  require_device "$device"

  # Two calls. /status answers with the last values it saw and says nothing
  # about reachability, so an unplugged AC returns yesterday's numbers and
  # looks healthy. /health is the only thing that tells the two apart.
  local health online="null"
  if (( ! quick )); then
    health=$(api GET "/devices/$device/health") || exit $?
    online=$(jq -r 'if .state == "ONLINE" then "true" else "false" end' <<<"$health") || die "malformed health response" 8
    [[ $online == true || $online == false ]] || die "unexpected online value: $online" 8
  fi

  api GET "/devices/$device/status" | jq_shape --argjson online "$online" "$JQ_CLAMP"'
    .components.main as $m | {
      power:       ($m.switch.switch.value // "off" | clampstr),
      temperature: ($m.temperatureMeasurement.temperature.value // null),
      setpoint:    ($m.thermostatCoolingSetpoint.coolingSetpoint.value // null),
      unit:        ($m.temperatureMeasurement.temperature.unit // "C" | clampstr),
      online:      $online,

      mode:    ($m.airConditionerMode.airConditionerMode.value // null | clampstr),
      fan:     ($m.airConditionerFanMode.fanMode.value // null | clampstr),
      swing:   ($m.fanOscillationMode.fanOscillationMode.value // null | clampstr),
      preset:  ($m["custom.airConditionerOptionalMode"].acOptionalMode.value // null | clampstr),
      humidity: ($m.relativeHumidityMeasurement.humidity.value // null),

      # The lists the device itself publishes. The panel builds its pills from
      # these rather than from a hardcoded set, so a firmware update that drops
      # a mode removes its button without a code change.
      supported: {
        mode:   ($m.airConditionerMode.supportedAcModes.value | clamplist),
        fan:    ($m.airConditionerFanMode.supportedAcFanModes.value | clamplist),
        swing:  ($m.fanOscillationMode.supportedFanOscillationModes.value | clamplist),
        preset: ($m["custom.airConditionerOptionalMode"].supportedAcOptionalMode.value | clamplist)
      },

      # Read from the device, not assumed. The old hardcoded 16-30 happened to
      # match this unit; on another one it would have been wrong.
      setpointMin: ($m["custom.thermostatSetpointControl"].minimumSetpoint.value // null),
      setpointMax: ($m["custom.thermostatSetpointControl"].maximumSetpoint.value // null)
    }'
}

# ---------------------------------------------------------------- commands --

send_command() {
  local device="$1" capability="$2" command="$3" args_json="${4:-[]}" body verdict
  body=$(jq -cn --arg c "$capability" --arg k "$command" --argjson a "$args_json" \
    '{commands:[{component:"main", capability:$c, command:$k, arguments:$a}]}')
  # A refused command is not an HTTP error: the API answers 200 and puts the
  # verdict in results[].status. Printing ok without reading it would report a
  # success the cloud never claimed. An absent results array is treated as
  # success -- some deployments omit it, and inventing a failure is worse than
  # trusting the 2xx.
  verdict=$(api POST "/devices/$device/commands" "$body" | jq -r '
    if (.results | type) == "array" and (.results | length) > 0
    then ([.results[].status] | map(select(. != "COMPLETED" and . != "ACCEPTED")) | .[0] // "COMPLETED")
    else "COMPLETED" end' 2>/dev/null)
  case "$verdict" in
    COMPLETED|ACCEPTED|"") printf '{"ok":true}\n' ;;
    *) die "SmartThings refused the command ($verdict)" 8 ;;
  esac
}

cmd_power() {
  local state="${1:-}"; shift || true
  [[ $state == on || $state == off ]] || die "usage: smartac power on|off --device <id>" 2
  local device=""
  while (( $# )); do
    case "$1" in
      --device) [[ -n ${2:-} ]] || die "--device requires a value" 2; device="$2"; shift 2 ;;
      *)        die "unknown argument: $1" 2 ;;
    esac
  done
  require_device "$device"
  send_command "$device" switch "$state"
}

# Validates against what the device publishes as supported, then sends. That
# costs one extra GET per write, which is the price of not shipping a hardcoded
# list that silently diverges from the hardware -- but only for a caller that
# does not already hold the list. The panel builds its buttons from the very
# same supported arrays, so it cannot offer an unsupported value, and it passes
# --no-validate to skip the round trip. Its safety net is send_command, which
# now surfaces a refusal the API reports.
send_enum_command() {
  local device="$1" value="$2" capability="$3" command="$4" jqpath="$5" label="$6" validate="${7:-1}"
  local supported
  if [[ $validate != 1 ]]; then
    send_command "$device" "$capability" "$command" "$(jq -cn --arg v "$value" '[$v]')"
    return
  fi
  supported=$(api GET "/devices/$device/status" \
    | jq_shape -r --arg p "$jqpath" "$JQ_CLAMP"'.components.main[$p] // {} | to_entries[]
        | select(.key | startswith("supported")) | (.value.value | clamplist) | .[]' 2>/dev/null \
    | sort -u | head -n "$MAX_LIST")
  [[ -n $supported ]] || die "the device published no supported $label values" 9
  grep -qxF -- "$value" <<<"$supported" \
    || die "$label '$value' is not supported by this device; supported: $(tr '\n' ' ' <<<"$supported" | sed 's/ $//' | cut -c "1-$((MAX_STRING * 8))")" 2
  send_command "$device" "$capability" "$command" "$(jq -cn --arg v "$value" '[$v]')"
}

cmd_enum() {
  local kind="$1"; shift
  local value="${1:-}"; shift || true
  [[ -n $value ]] || die "usage: smartac $kind <value> --device <id>" 2
  local device="" validate=1
  while (( $# )); do
    case "$1" in
      --device)      [[ -n ${2:-} ]] || die "--device requires a value" 2; device="$2"; shift 2 ;;
      --no-validate) validate=0; shift ;;
      *) die "unknown argument: $1" 2 ;;
    esac
  done
  require_device "$device"
  case "$kind" in
    mode)   send_enum_command "$device" "$value" airConditionerMode setAirConditionerMode airConditionerMode mode "$validate" ;;
    fan)    send_enum_command "$device" "$value" airConditionerFanMode setFanMode airConditionerFanMode fan "$validate" ;;
    swing)  send_enum_command "$device" "$value" fanOscillationMode setFanOscillationMode fanOscillationMode swing "$validate" ;;
    preset) send_enum_command "$device" "$value" custom.airConditionerOptionalMode setAcOptionalMode custom.airConditionerOptionalMode preset "$validate" ;;
  esac
}

cmd_temp() {
  local value="${1:-}"; shift || true
  [[ $value =~ ^-?[0-9]+([.][0-9]+)?$ ]] || die "temperature must be a number" 2
  local device=""
  while (( $# )); do
    case "$1" in
      --device) [[ -n ${2:-} ]] || die "--device requires a value" 2; device="$2"; shift 2 ;;
      *)        die "unknown argument: $1" 2 ;;
    esac
  done
  require_device "$device"
  # --argjson, not --arg: the API rejects a quoted number for this argument.
  send_command "$device" thermostatCoolingSetpoint setCoolingSetpoint "[$value]"
}

# ------------------------------------------------------------------ doctor --

cmd_doctor() {
  local caps=0 device=""
  while (( $# )); do
    case "$1" in
      --capabilities) caps=1; shift ;;
      --device) [[ -n ${2:-} ]] || die "--device requires a value" 2; device="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  if (( caps )); then
    require_device "$device"
    local devices_payload capabilities_list device_found
    devices_payload=$(api GET /devices) || return 1
    capabilities_list=$(jq_shape -r --arg d "$device" "$JQ_CLAMP"'.items[]? | select(.deviceId == $d)
          | .components[]?.capabilities[]?.id | clampstr' <<<"$devices_payload" | sort | head -n "$MAX_LIST")
    device_found=$(jq -r --arg d "$device" '[.items[] | select(.deviceId == $d)] | length' <<<"$devices_payload")
    if [[ $device_found -eq 0 ]]; then
      die "device not found: $device" 2
    fi
    printf '%s\n' "$capabilities_list"
    return 0
  fi

  printf 'SmartThings AC doctor\n\n'
  for c in curl jq; do
    command -v "$c" >/dev/null 2>&1 \
      && printf '  ok    %s\n' "$c" || printf '  FAIL  %s is missing\n' "$c"
  done

  local t
  if resolve_token 2>/dev/null; then
    t="$TOKEN_VALUE"
    if cli_bin >/dev/null 2>&1; then
      # Four characters tells two sessions apart and is not enough to use one.
      printf '  ok    SmartThings CLI session (%s...) — renews itself\n' "${t:0:4}"
    else
      # Real, and unrenewable: the CLI refreshes only when one of its own
      # commands runs, and there is none on PATH. Left unsaid, this looks
      # healthy for a day and then fails with no hint why.
      printf '  --    CLI session found (%s...) but the smartthings binary is gone\n' "${t:0:4}"
      printf '        it cannot renew and will expire; reinstall it:\n'
      printf '        npm install -g @smartthings/cli\n'
    fi
  else
    printf '  FAIL  no SmartThings CLI session\n'
    cli_bin >/dev/null 2>&1 \
      && printf '        run: smartthings locations\n' \
      || printf '        run: npm install -g @smartthings/cli && smartthings locations\n'
    return 1
  fi

  local devices_json
  devices_json=$(cmd_devices) || return 1
  local n
  n=$(jq -r '.devices | length' <<<"$devices_json") || die "failed to parse devices" 8
  printf '  ok    reachable, %s air conditioner(s) visible\n' "$n"
}

case "${1:-}" in
  credential) shift; cmd_credential "$@" ;;
  devices) cmd_devices ;;
  status)  shift; cmd_status "$@" ;;
  power)   shift; cmd_power "$@" ;;
  temp)    shift; cmd_temp "$@" ;;
  mode|fan|swing|preset) k="$1"; shift; cmd_enum "$k" "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  *) die "usage: smartac credential|devices|status|power|temp|doctor" 2 ;;
esac
